{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate preset for HCC frontend repositories",
  "extends": ["config:recommended"],
  "semanticCommits": "enabled",
  "minimumReleaseAge": "2 days",
  "tekton": {
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "description": "Use bump strategy for npm dependencies",
      "matchManagers": ["npm"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Group npm minor/patch updates for production dependencies",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchDepTypes": ["dependencies", "optionalDependencies", "peerDependencies"],
      "groupName": "npm minor and patch dependencies"
    },
    {
      "description": "Group npm minor/patch updates for devDependencies",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchDepTypes": ["devDependencies"],
      "groupName": "npm minor and patch devDependencies"
    },
    {
      "description": "Disable major updates to avoid breaking changes",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Use fix commit type for production dependencies (triggers version bump and publish)",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies", "optionalDependencies", "peerDependencies"],
      "semanticCommitType": "fix"
    },
    {
      "description": "Use chore commit type for devDependencies (no publish needed)",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "semanticCommitType": "chore"
    }
  ]
}
